# Copy to `.env` in the repo root and fill in real values.
# Do not commit `.env` — it contains secrets.

# --- Database (Supabase Transaction Pooler) ---
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-db-password
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=6543
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_TEAM_IMAGE_BUCKET=team-images
SUPABASE_FIGHTER_IMAGE_BUCKET=fighter-images
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Service API keys ---
IMAGE_SERVICE_KEY=your-image-service-key
UPLOADER_SERVICE_KEY=your-uploader-service-key
PIPELINE_SERVICE_API_KEY=your-pipeline-service-api-key

# --- API URLs ---
# Host / IDE: http://localhost:8000
# Inside Docker Compose, services override these to http://web:8000
BASE_API_URL=http://localhost:8000
PIPELINE_API_BASE_URL=http://localhost:8000

# --- Pub/Sub emulator ---
# Host / IDE debugger:
PUBSUB_EMULATOR_HOST=localhost:8085
# Inside Docker Compose, services override to: pubsub:8085
GOOGLE_CLOUD_PROJECT=local-project
PUBSUB_IMAGE_JOB_TOPIC=image-jobs
PUBSUB_IMAGE_SUBSCRIPTION=image-worker-sub
PUBSUB_FIGHTS_IN_EVENT_TOPIC=fights-in-event
PUBSUB_FIGHTS_IN_EVENT_SUBSCRIPTION=fights-in-event-sub
PUBSUB_FIGHTS_IN_EVENT_TIMEOUT=120
PUBSUB_FIGHTER_PROFILE_TOPIC=fighter-profile-jobs
PUBSUB_FIGHTER_PROFILE_SUBSCRIPTION=fighter-profile-jobs-sub
PUBSUB_FIGHT_STATS_TOPIC=fight-stats-jobs
PUBSUB_FIGHT_STATS_SUBSCRIPTION=fight-stats-jobs-sub
PUBSUB_CAREER_STATS_TOPIC=career-stats-jobs

# --- Worker idle shutdown ---
# Production default (when unset) is enabled with a 60s timeout.
# Docker Compose sets WORKER_IDLE_SHUTDOWN_ENABLED=false for local workers.
WORKER_IDLE_SHUTDOWN_ENABLED=false
WORKER_IDLE_TIMEOUT_SECONDS=60
WORKER_IDLE_CHECK_INTERVAL_SECONDS=5
